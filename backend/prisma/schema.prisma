generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AgentType {
  PLANNER
  RESEARCHER
  MEMORY
  FINANCE
  HEALTH
  COMMUNICATION
  CUSTOM
}

enum WorkflowStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  name           String
  passwordHash   String
  avatar         String?
  trustLevel     Int       @default(1)
  plan           String    @default("Free")
  city           String?
  preferences    Json      @default("{}")
  phone          String?   @unique
  emailVerified  Boolean   @default(false)
  verifyToken    String?
  verifyTokenExp DateTime?
  onboardingDone Boolean   @default(false)
  createdAt      DateTime  @default(now())

  notifications             Notification[]
  deviceNotificationTokens  DeviceNotificationToken[]
  agentLedgers              AgentLedger[]
  trustScore                TrustScore?
  userProfile               UserProfile?
  familyConnectionsSent     FamilyConnection[]        @relation("ConnectionRequester")
  familyConnectionsReceived FamilyConnection[]        @relation("ConnectionReceiver")
  familyTasksCreated        FamilyTask[]              @relation("FamilyTaskCreator")
  familyTasksAssigned       FamilyTask[]              @relation("FamilyTaskAssignee")
  parentMedications         ParentMedication[]
  pets                      Pet[]
  petReminders              PetReminder[]
  familyItems               FamilyItem[]
  loans                     Loan[]
  emis                      Emi[]
  subscriptions             Subscription[]
  bills                     Bill[]

  conversations Conversation[]
  agents        Agent[]
  workflows     Workflow[]
  documents     Document[]
  tasks         Task[]
}

model UserProfile {
  id                   String   @id @default(uuid())
  userId               String   @unique
  // About
  nickname             String?
  dateOfBirth          String?
  gender               String?
  country              String?
  city                 String?
  timezone             String?
  language             String?
  // Work
  occupation           String?
  company              String?
  industry             String?
  professionalLevel    String?
  skills               Json     @default("[]")
  learningTopics       Json     @default("[]")
  careerGoals          String?
  // Interests
  interests            Json     @default("[]")
  followTopics         Json     @default("[]")
  // Goals
  goals                Json     @default("[]")
  topGoal              String?
  // Lifestyle
  wakeTime             String?
  sleepTime            String?
  workingHours         String?
  exerciseFrequency    String?
  workMode             String?
  productiveTime       String?
  // Health
  height               String?
  weight               String?
  bloodGroup           String?
  diet                 String?
  exerciseLevel        String?
  medicalConditions    String?
  allergies            String?
  healthConnect        String?
  // Finance
  financeCountry       String?
  currency             String?
  monthlyBudget        String?
  investmentExp        String?
  investmentPlatforms  Json     @default("[]")
  investmentTypes      Json     @default("[]")
  upiApps              Json     @default("[]")
  monitorBills         Boolean  @default(false)
  // Family
  familyReminders      Boolean  @default(false)
  familyMembers        Json     @default("[]")
  schoolReminders      Boolean  @default(false)
  medicineReminders    Boolean  @default(false)
  vaccinationReminders Boolean  @default(false)
  // AI Preferences
  aiPersonality        String   @default("Friendly")
  responseLength       String   @default("Medium")
  aiVoice              String   @default("None")
  enableMemory         Boolean  @default(true)
  proactiveSuggestions Boolean  @default(true)
  dailySummary         Boolean  @default(true)
  weeklyReport         Boolean  @default(false)
  // Connections
  connectedApps        Json     @default("[]")
  // Memory
  aiMemories           Json     @default("[]")
  // Completion
  completedSections    Json     @default("[]")
  completionPct        Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Conversation {
  id        String   @id @default(uuid())
  title     String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([userId])
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  role           String
  content        String   @db.Text
  embeddingId    String?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model Agent {
  id          String    @id @default(uuid())
  name        String
  type        AgentType
  description String?
  config      Json?
  userId      String
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Workflow {
  id          String         @id @default(uuid())
  name        String
  description String?
  status      WorkflowStatus @default(PENDING)
  userId      String
  createdAt   DateTime       @default(now())

  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  executions WorkflowExecution[]

  @@index([userId])
}

model WorkflowExecution {
  id          String    @id @default(uuid())
  workflowId  String
  status      String
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
}

model KnowledgeSource {
  id         String   @id @default(uuid())
  name       String
  sourceType String
  url        String?
  createdAt  DateTime @default(now())

  documents Document[]
}

model Document {
  id                String   @id @default(uuid())
  title             String
  filePath          String?
  qdrantCollection  String?
  knowledgeSourceId String?
  userId            String
  createdAt         DateTime @default(now())

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  knowledgeSource KnowledgeSource? @relation(fields: [knowledgeSourceId], references: [id])

  @@index([userId])
}

model Task {
  id          String   @id @default(uuid())
  title       String
  description String?
  status      String   @default("PENDING")
  userId      String
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ToolExecution {
  id        String   @id @default(uuid())
  toolName  String
  status    String
  input     Json?
  output    Json?
  createdAt DateTime @default(now())
}

model ApprovalRequest {
  id        String   @id @default(uuid())
  action    String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  message   String
  read      Boolean  @default(false)
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceId  String?
  priority  Int      @default(0)

  @@unique([userId, sourceId])
  @@index([userId])
}

model DeviceNotificationToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AgentLedger {
  id        String   @id @default(uuid())
  userId    String
  action    String
  tool      String
  status    String
  signature String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model FamilyConnection {
  id           String   @id @default(uuid())
  requesterId  String
  receiverId   String
  relationship String
  status       String   @default("PENDING") // PENDING, ACCEPTED, REJECTED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  requester User         @relation("ConnectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  receiver  User         @relation("ConnectionReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  tasks     FamilyTask[]

  @@unique([requesterId, receiverId])
  @@index([requesterId])
  @@index([receiverId])
}

model FamilyTask {
  id           String   @id @default(uuid())
  connectionId String
  creatorId    String
  assigneeId   String
  title        String
  description  String?
  status       String   @default("PENDING_ACCEPTANCE")
  priority     String   @default("Medium")
  category     String?
  dueDate      String?
  recurrence   String   @default("None")
  checklist    Json     @default("[]")
  comments     Json     @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  connection FamilyConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  creator    User             @relation("FamilyTaskCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  assignee   User             @relation("FamilyTaskAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)

  @@index([connectionId])
  @@index([creatorId])
  @@index([assigneeId])
}

model TrustScore {
  id              String @id @default(uuid())
  userId          String @unique
  score           Int    @default(0)
  approvedActions Int    @default(0)
  rejectedActions Int    @default(0)
  executedActions Int    @default(0)
  user            User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Pet {
  id            String   @id @default(uuid())
  userId        String
  name          String
  species       String
  breed         String?
  sex           String?
  dob           String?
  microchip     String?
  weight        String?
  height        String?
  coatType      String?
  colorMarkings String?
  // Health (stored as JSON arrays)
  vaccines      Json     @default("[]")
  medications   Json     @default("[]")
  allergies     Json     @default("[]")
  vet           Json?
  // Routine
  feeding       Json?
  groomings     Json     @default("[]")
  exercises     Json     @default("[]")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminders PetReminder[]

  @@index([userId])
}

model PetReminder {
  id        String    @id @default(uuid())
  petId     String
  userId    String
  type      String
  title     String
  remindAt  DateTime?
  notes     String?
  done      Boolean   @default(false)
  createdAt DateTime  @default(now())

  pet  Pet  @relation(fields: [petId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([petId])
  @@index([userId])
  @@index([remindAt])
}

// Generic family item store — covers Children, HomeMaintenance, Celebrations, Calendar
model FamilyItem {
  id        String    @id @default(uuid())
  userId    String
  domain    String // 'children' | 'home' | 'celebration' | 'calendar'
  type      String // sub-type within domain e.g. 'child', 'activity', 'event', 'task', 'contact', 'warranty', 'occasion', 'gift'
  data      Json // full item payload
  remindAt  DateTime?
  done      Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([domain])
  @@index([remindAt])
}

model Loan {
  id                  String    @id @default(uuid())
  userId              String
  name                String
  loanType            String // Personal/Home/Car/Education/Business/Gold/Other
  lenderName          String
  accountNumber       String?
  purpose             String?
  status              String    @default("Active") // Active/Closed/Pending
  originalAmount      Float
  outstandingAmount   Float
  amountPaid          Float     @default(0)
  processingFee       Float?
  otherCharges        Float?
  interestRate        Float
  interestType        String // Fixed/Floating
  interestCalculation String // Reducing Balance/Flat Rate
  emiAmount           Float
  emiFrequency        String    @default("Monthly")
  emiStartDate        DateTime
  nextEmiDate         DateTime?
  emiEndDate          DateTime?
  numberOfEmis        Int
  emisPaid            Int       @default(0)
  emisRemaining       Int?
  loanStartDate       DateTime
  loanMaturityDate    DateTime?
  autoDebit           Boolean   @default(false)
  paymentAccount      String?
  paymentDay          Int?
  prepaymentAllowed   Boolean?
  prepaymentCharges   Float?
  notes               String?
  attachmentDocId     String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Emi {
  id                    String    @id @default(uuid())
  userId                String
  name                  String
  emiType               String // Loan EMI/Credit Card EMI/Product EMI/Other
  provider              String
  description           String?
  totalAmount           Float
  downPayment           Float?
  financedAmount        Float
  emiAmount             Float
  interestRate          Float?
  processingFee         Float?
  totalPayable          Float?
  numberOfInstallments  Int
  installmentsPaid      Int       @default(0)
  installmentsRemaining Int?
  startDate             DateTime
  nextPaymentDate       DateTime?
  endDate               DateTime?
  frequency             String    @default("Monthly")
  paymentMethod         String?
  autoDebit             Boolean   @default(false)
  paymentAccount        String?
  paymentDay            Int?
  status                String    @default("Active") // Active/Completed/Overdue/Cancelled
  productName           String?
  orderReference        String?
  notes                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Subscription {
  id                    String    @id @default(uuid())
  userId                String
  name                  String
  category              String // Streaming/Software/Cloud/Gaming/News/Fitness/Education/Other
  provider              String?
  description           String?
  amount                Float
  currency              String    @default("INR")
  billingCycle          String    @default("Monthly") // Weekly/Monthly/Quarterly/Half-Yearly/Yearly
  tax                   Float?
  totalCharged          Float?
  startDate             DateTime
  nextBillingDate       DateTime?
  renewalDate           DateTime?
  cancellationDate      DateTime?
  paymentMethod         String? // Card/Bank/UPI/Wallet/Other
  paymentAccount        String?
  autoRenewal           Boolean   @default(true)
  status                String    @default("Active") // Active/Paused/Cancelled/Expired
  trialPeriod           Boolean   @default(false)
  trialEndDate          DateTime?
  reminderBeforeRenewal Int? // days before renewal
  notes                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Bill {
  id              String    @id @default(uuid())
  userId          String
  name            String
  category        String // Electricity/Water/Internet/Mobile/Gas/Rent/Maintenance/Insurance/Other
  provider        String?
  accountNumber   String?
  description     String?
  expectedAmount  Float?
  lastBillAmount  Float?
  minAmount       Float?
  maxAmount       Float?
  currency        String    @default("INR")
  billingCycle    String    @default("Monthly") // Weekly/Monthly/Quarterly/Yearly/Custom
  billDate        DateTime?
  dueDate         DateTime
  nextDueDate     DateTime?
  gracePeriod     Int? // days
  paymentMethod   String?
  paymentAccount  String?
  autoPay         Boolean   @default(false)
  autoPayDate     DateTime?
  status          String    @default("Upcoming") // Upcoming/Due/Paid/Overdue
  lateFee         Float?
  tax             Float?
  reminderDays    Int?
  notes           String?
  attachmentDocId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ParentMedication {
  id         String   @id @default(uuid())
  userId     String
  medName    String
  dosage     String
  frequency  String
  mealTime   String?
  parent     String
  startDate  String?
  duration   String?
  doctor     String?
  notes      String?
  refillDate String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
